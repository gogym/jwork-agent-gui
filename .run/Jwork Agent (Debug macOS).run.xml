<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Jwork Agent (Debug macOS)" type="Application" factoryName="Application">
    <option name="MAIN_CLASS_NAME" value="com.gettyio.jwork.agent.ui.Launcher" />
    <module name="jwork-agent-ui" />
    <!-- mac 专属：在 Windows Debug 配置基础上追加 sun.lwawt 两条 opens（jcefmaven 官方 JDK16+ 要求）；
