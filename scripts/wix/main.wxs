          <Publish Event="EndDialog" Value="Return" Order="1">1</Publish>
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Disabled="yes" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Text" Type="Text" X="20" Y="53" Width="330" Height="50" TabSkip="yes" Text="[L_DiskCost_Text]" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="20" Y="20" Width="280" Height="20" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_DiskCost_Desc]" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_DiskCost_Title]" />
        <Control Id="VolumeList" Type="VolumeCostList" X="20" Y="100" Width="330" Height="120" Sunken="yes" Fixed="yes" Remote="yes" TabSkip="yes" Text="{120}{70}{70}{70}{70}" />
      </Dialog>

      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="[L_DlgTitle]" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="48" Y="15" Width="205" Height="60" NoPrefix="yes" TabSkip="no" Text="[L_Error_Text]" />
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[L_Yes]">
          <Publish Event="EndDialog" Value="ErrorYes" Order="1">1</Publish>
