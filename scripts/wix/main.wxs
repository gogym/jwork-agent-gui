      </Dialog>

      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="[L_DlgTitle]">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Default="yes" Text="下一步(&amp;N)">
          <Publish Property="WixUI_InstallMode" Value="Update" Order="1">Installed AND PATCH</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="NextTw" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Text="下一步(&amp;N)">
          <Publish Property="WixUI_InstallMode" Value="Update" Order="1">Installed AND PATCH</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="NextEn" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Text="&amp;Next">
          <Publish Property="WixUI_InstallMode" Value="Update" Order="1">Installed AND PATCH</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="CancelTw" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="CancelEn" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Disabled="yes" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="上一步(&amp;B)">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="BackTw" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="上一步(&amp;B)">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="BackEn" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="&amp;Back">
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安装向导将在计算机上安装 $(var.JpAppName)。单击“下一步”继续，或单击“取消”退出安装向导。">
          <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="hide">Installed AND PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="DescriptionTw" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安裝精靈將在電腦上安裝 $(var.JpAppName)。按一下「下一步」繼續，或按一下「取消」結束安裝精靈。">
          <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="hide">Installed AND PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="DescriptionEn" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="The Setup Wizard will install $(var.JpAppName) on your computer. Click Next to continue or Cancel to exit the Setup Wizard.">
          <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="hide">Installed AND PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="PatchDescription" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安装向导将更新您计算机上的 $(var.JpAppName)。单击“下一步”继续或单击“取消”退出安装向导。">
          <Condition Action="show">Installed AND PATCH</Condition>
          <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="PatchDescriptionTw" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安裝精靈將更新您電腦上的 $(var.JpAppName)。按一下「下一步」繼續，或按一下「取消」結束安裝精靈。">
          <Condition Action="show">Installed AND PATCH</Condition>
          <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="PatchDescriptionEn" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="The Setup Wizard will update $(var.JpAppName) on your computer. Click Next to continue or Cancel to exit the Setup Wizard.">
          <Condition Action="show">Installed AND PATCH</Condition>
          <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="{\WixUI_Font_Bigger}欢迎使用 $(var.JpAppName) 安装向导">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="TitleTw" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="{\WixUI_Font_Bigger}歡迎使用 $(var.JpAppName) 安裝精靈">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="TitleEn" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="{\WixUI_Font_Bigger}Welcome to the $(var.JpAppName) Setup Wizard">
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="LangCombo" Type="ComboBox" X="10" Y="243" Width="90" Height="120" Property="JWORKLANG_SEL" TabSkip="yes">
          <Publish Event="DoAction" Value="JpApplyLang" Order="1">1</Publish>
          <Publish Event="NewDialog" Value="WelcomeDlgAlt" Order="2"><![CDATA[JWORKLANG_DIRTY="1"]]></Publish>
        </Control>
      </Dialog>

      <Dialog Id="WelcomeDlgAlt" Width="370" Height="270" Title="[L_DlgTitle]">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Default="yes" Text="下一步(&amp;N)">
          <Publish Property="WixUI_InstallMode" Value="Update" Order="1">Installed AND PATCH</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="NextTw" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Text="下一步(&amp;N)">
          <Publish Property="WixUI_InstallMode" Value="Update" Order="1">Installed AND PATCH</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="NextEn" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Text="&amp;Next">
          <Publish Property="WixUI_InstallMode" Value="Update" Order="1">Installed AND PATCH</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="CancelTw" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="CancelEn" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Disabled="yes" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="上一步(&amp;B)">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="BackTw" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="上一步(&amp;B)">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="BackEn" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="&amp;Back">
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安装向导将在计算机上安装 $(var.JpAppName)。单击“下一步”继续，或单击“取消”退出安装向导。">
          <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="hide">Installed AND PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="DescriptionTw" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安裝精靈將在電腦上安裝 $(var.JpAppName)。按一下「下一步」繼續，或按一下「取消」結束安裝精靈。">
          <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="hide">Installed AND PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="DescriptionEn" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="The Setup Wizard will install $(var.JpAppName) on your computer. Click Next to continue or Cancel to exit the Setup Wizard.">
          <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="hide">Installed AND PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="PatchDescription" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安装向导将更新您计算机上的 $(var.JpAppName)。单击“下一步”继续或单击“取消”退出安装向导。">
          <Condition Action="show">Installed AND PATCH</Condition>
          <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="PatchDescriptionTw" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="安裝精靈將更新您電腦上的 $(var.JpAppName)。按一下「下一步」繼續，或按一下「取消」結束安裝精靈。">
          <Condition Action="show">Installed AND PATCH</Condition>
          <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="PatchDescriptionEn" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="The Setup Wizard will update $(var.JpAppName) on your computer. Click Next to continue or Cancel to exit the Setup Wizard.">
          <Condition Action="show">Installed AND PATCH</Condition>
          <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="{\WixUI_Font_Bigger}欢迎使用 $(var.JpAppName) 安装向导">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-CN"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="TitleTw" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="{\WixUI_Font_Bigger}歡迎使用 $(var.JpAppName) 安裝精靈">
          <Condition Action="show"><![CDATA[JWORKLANG="zh-TW"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="TitleEn" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="{\WixUI_Font_Bigger}Welcome to the $(var.JpAppName) Setup Wizard">
          <Condition Action="show"><![CDATA[JWORKLANG="en"]]></Condition>
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
        <Control Id="LangCombo" Type="ComboBox" X="10" Y="243" Width="90" Height="120" Property="JWORKLANG_SEL" TabSkip="yes">
          <Publish Event="DoAction" Value="JpApplyLang" Order="1">1</Publish>
          <Publish Event="NewDialog" Value="WelcomeDlg" Order="2"><![CDATA[JWORKLANG_DIRTY="1"]]></Publish>
        </Control>
      </Dialog>

<!-- fragment 自带属性（ErrorDlg 引擎挂接 / RM 默认选项） -->
      <Property Id="ErrorDialog" Value="ErrorDlg" />
      <Property Id="WixUIRMOption" Value="UseRM" />

      <!-- 不写 DialogRef：WiX3 linker 解析引用优先库 fragment，DialogRef 会把扩展库
           同 Id 对话框拉入与本地定义撞车（LGHT0091）。本地定义在 Product 内无条件链入，
           Publish/Show 中的对话框名是运行时字符串，无需链接期引用。
           例外：ShortcutPromptDlg 定义在独立 fragment（jpackage 资源覆盖版），扩展库无同 Id
           符号，必须经 DialogRef 链入，否则不进 Dialog 表（ICE44）。 -->
      <DialogRef Id="ShortcutPromptDlg" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <!-- 欢迎页三分拆分控件的繁中/英文 Next 变体（Id 后缀 Tw/En）同步分支接线：
           基 Id 变体由上面两行覆盖，fragment 里没有这些控件的事件行 -->
      <Publish Dialog="WelcomeDlg" Control="NextTw" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="NextTw" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="WelcomeDlg" Control="NextEn" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="NextEn" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <!-- Alt 孪生页（下拉确认选语言后重建到此页）：导航分支与原页镜像一致，
           Cancel/InstallMode 行随 fragment children 自动拷贝 -->
      <Publish Dialog="WelcomeDlgAlt" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlgAlt" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="WelcomeDlgAlt" Control="NextTw" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlgAlt" Control="NextTw" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="WelcomeDlgAlt" Control="NextEn" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlgAlt" Control="NextEn" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="JworkDataDlg" Order="4"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID="1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="JworkDataDlg" Order="4">WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <Publish Dialog="JworkDataDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>
      <Publish Dialog="JworkDataDlg" Control="Next" Event="NewDialog" Value="ShortcutPromptDlg">1</Publish>
      <Publish Dialog="ShortcutPromptDlg" Control="Back" Event="NewDialog" Value="JworkDataDlg">1</Publish>
      <Publish Dialog="ShortcutPromptDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutPromptDlg">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">Installed AND PATCH</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="NextTw" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="NextEn" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlgAlt" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlgAlt" Control="NextTw" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlgAlt" Control="NextEn" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
    </UI>
    <!-- jpackage 默认生成的 ui.wxf 带 UIRef WixUI_InstallDir，会拉入扩展库整套对话框
         fragment 与本地同 Id 定义撞车（LGHT0091），且 WiX3 linker 解析引用优先库 fragment，
         本地影子 UI 无效。解法：scripts/wix/ui.wxf 覆盖版把该 UIRef 换成 WixUI_Common
         （仅位图/图标 Binary 与 UIText），对话框引用全部解析到本地定义。 -->
    <UIRef Id="WixUI_Common" />
    <!-- 许可证页内容：三语各一份 RTF（build/gen/make-license-rtf.ps1 从 license-src 生成，
         经 package-windows.ps1 4.1 补拷进 config），LicenseAgreementDlg 内三个 ScrollableText
         按 JWORKLANG 显隐其一；双语同屏版 license.rtf 仅作 jpackage license-file 参数入参保留 -->
    <WixVariable Id="JpLicenseRtfZhCN" Value="$(var.JpConfigDir)\license-zh-cn.rtf" />
    <WixVariable Id="JpLicenseRtfZhTW" Value="$(var.JpConfigDir)\license-zh-tw.rtf" />
    <WixVariable Id="JpLicenseRtfEn" Value="$(var.JpConfigDir)\license-en.rtf" />
    <!-- 品牌位图覆盖 WiX 默认 banner/dialog（默认 banner 右侧是红色禁止地球图标） -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.JpConfigDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.JpConfigDir)\dialog.bmp" />
    <UIRef Id="JworkWizard"/>

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>
      <RemoveExistingProducts Before="CostInitialize"/>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
      <!-- 静默路径（msiexec /qn）跳过 UI，数据目录与语言恢复须在执行序列同样生效 -->
      <Custom Action="JpRestoreDataDir" After="AppSearch">JWORKDATA_EXISTING</Custom>
      <Custom Action="JpSetDefaultDataDir" After="AppSearch">NOT JWORKDATA_EXISTING</Custom>
      <Custom Action="JpRestoreLang" After="AppSearch">JWORKLANG_EXISTING</Custom>
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
      <Custom Action="JpRestoreDataDir" After="AppSearch">JWORKDATA_EXISTING</Custom>
      <Custom Action="JpSetDefaultDataDir" After="AppSearch">NOT JWORKDATA_EXISTING</Custom>
      <Custom Action="JpRestoreLang" After="AppSearch">JWORKLANG_EXISTING</Custom>
      <!-- 首页渲染前应用语言（恢复值或默认简中），初始化 JWORKLANG_SEL 并替换文案内嵌 [ProductName] -->
      <Custom Action="JpApplyLang" After="JpRestoreLang"/>
      <!-- 基线序列入口（照 WixUI 各 fragment 自带 Show 复制）：欢迎/维护欢迎/恢复三选一 -->
      <Show Dialog="WelcomeDlg" Before="ProgressDlg">NOT Installed OR PATCH</Show>
      <Show Dialog="MaintenanceWelcomeDlg" Before="ProgressDlg">Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH</Show>
      <Show Dialog="ResumeDlg" Before="ProgressDlg">Installed AND (RESUME OR Preselected)</Show>
      <Show Dialog="PrepareDlg" After="AppSearch"/>
      <Show Dialog="ProgressDlg" Before="ExecuteAction"/>
      <Show Dialog="ExitDialog" OnExit="success"/>
      <Show Dialog="UserExit" OnExit="cancel"/>
      <Show Dialog="FatalError" OnExit="error"/>
    </InstallUISequence>

    <!-- 库对话框 fragment 被排除后，其自带的 AdminUISequence 退出页条目须自行补齐（ICE20，照基线） -->
    <AdminUISequence>
      <Show Dialog="ExitDialog" OnExit="success"/>
      <Show Dialog="UserExit" OnExit="cancel"/>
      <Show Dialog="FatalError" OnExit="error"/>
    </AdminUISequence>

  </Product>
</Wix>