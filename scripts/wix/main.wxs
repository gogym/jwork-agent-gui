        <Control Id="RemoveDisabledText" Type="Text" X="60" Y="191" Width="280" Height="20" Hidden="yes" NoPrefix="yes" TabSkip="yes" Text="[L_MaintType_RemoveDisabled]">
          <Condition Action="show">ARPNOREMOVE</Condition>
