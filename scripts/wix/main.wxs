        <Control Id="Install" Type="PushButton" X="212" Y="243" Width="80" Height="17" Hidden="yes" ElevationShield="yes" TabSkip="no" Text="[L_Verify_Install]">
          <Condition Action="show">ALLUSERS</Condition>
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="1">!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">OutOfDiskSpace &lt;&gt; 1</Publish>
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="3">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST="P" OR NOT PROMPTROLLBACKCOST)</Publish>
          <Publish Event="EndDialog" Value="Return" Order="4">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="EnableRollback" Value="False" Order="5">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="6">(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST="F")</Publish>
        </Control>
        <Control Id="InstallNoShield" Type="PushButton" X="212" Y="243" Width="80" Height="17" Hidden="yes" TabSkip="no" Default="yes" Text="[L_Verify_Install]">
          <Condition Action="show">NOT ALLUSERS</Condition>
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="1">!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">OutOfDiskSpace &lt;&gt; 1</Publish>
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="3">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST="P" OR NOT PROMPTROLLBACKCOST)</Publish>
          <Publish Event="EndDialog" Value="Return" Order="4">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="EnableRollback" Value="False" Order="5">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="6">(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST="F")</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Cancel="yes" Text="[L_Cancel]">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
        </Control>
