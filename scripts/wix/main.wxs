        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[L_Retry]">
          <Publish Event="EndDialog" Value="ErrorRetry" Order="1">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="270" Title="[L_DlgTitle]">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Default="yes" Cancel="yes" Text="[L_Finish]" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="[L_Cancel]" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Disabled="yes" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="no" Text="[L_Back]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_Exit_Desc]" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_Exit_Title]" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="80" Hidden="yes" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[WIXUI_EXITDIALOGOPTIONALTEXT]">
          <Condition Action="show">WIXUI_EXITDIALOGOPTIONALTEXT AND NOT Installed</Condition>
