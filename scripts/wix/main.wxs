      <Dialog Id="LicenseAgreementDlg" Width="370" Height="270" Title="[L_DlgTitle]">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Disabled="yes" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_License_Desc]" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_License_Title]" />
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="20" Y="207" Width="330" Height="18" Property="LicenseAccepted" CheckBoxValue="1" TabSkip="no" Text="[L_License_Accept]" />
        <Control Id="Print" Type="PushButton" X="112" Y="243" Width="56" Height="17" TabSkip="no" Text="[L_Print]">
          <Publish Event="DoAction" Value="WixUIPrintEula" Order="1">1</Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" TabSkip="no" Text="[L_Back]" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" TabSkip="no" Default="yes" Text="[L_Next]">
          <Condition Action="disable">LicenseAccepted &lt;&gt; "1"</Condition>
          <Condition Action="enable">LicenseAccepted = "1"</Condition>
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="1">!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Cancel="yes" Text="[L_Cancel]">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
        </Control>
        <Control Id="LicenseTextCN" Type="ScrollableText" X="20" Y="60" Width="330" Height="140" Sunken="yes" TabSkip="no">
          <Text SourceFile="!(wix.JpLicenseRtfZhCN)" />
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-CN"]]></Condition>
        </Control>
        <Control Id="LicenseTextTW" Type="ScrollableText" X="20" Y="60" Width="330" Height="140" Sunken="yes" TabSkip="no">
          <Text SourceFile="!(wix.JpLicenseRtfZhTW)" />
          <Condition Action="hide"><![CDATA[JWORKLANG<>"zh-TW"]]></Condition>
        </Control>
        <Control Id="LicenseTextEN" Type="ScrollableText" X="20" Y="60" Width="330" Height="140" Sunken="yes" TabSkip="no">
          <Text SourceFile="!(wix.JpLicenseRtfEn)" />
          <Condition Action="hide"><![CDATA[JWORKLANG<>"en"]]></Condition>
        </Control>
      </Dialog>

      <Dialog Id="MaintenanceTypeDlg" Width="370" Height="270" Title="[L_DlgTitle]">
