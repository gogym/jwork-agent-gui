<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <!-- 包语言 2052(zh-CN)：msi 无 ActionText 表时，安装执行阶段的状态行（如“正在复制新文件”）
       由引擎按包语言取自 msi.dll 内建本地化资源；jpackage 模板残留的 1033+无效 LCID 会退回
       英文模板串（ProgressDlg 状态显示 "Coping new files File: [1]..." 的根因） -->
  <?define JpProductLanguage=2052 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <Product
    Id="$(var.JpProductCode)"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <Binary Id="JpCaDll" SourceFile="wixhelper.dll"/>

    <CustomAction Id="JpFindRelatedProducts" BinaryKey="JpCaDll" DllEntry="FindRelatedProductsEx" />

    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <!-- 数据目录：安装器写 HKCU\Software\JavaSoft\Prefs\com\gettyio\jwork\dataDir，
         应用经 java.util.prefs.Preferences 读取（JworkPaths.defaultRoot）。
         升级/静默安装时先从注册表恢复已有选择，避免被默认值重置。 -->
    <Property Id="JWORKDATA_EXISTING">
      <RegistrySearch Id="JworkDataDirSearch" Root="HKCU"
                      Key="Software\JavaSoft\Prefs\com\gettyio\jwork" Name="dataDir" Type="raw"/>
    </Property>
    <CustomAction Id="JpRestoreDataDir" Property="JWORKDATADIR" Value="[JWORKDATA_EXISTING]"/>
    <CustomAction Id="JpSetDefaultDataDir" Property="JWORKDATADIR" Value="[%USERPROFILE]\.jwork"/>

    <!-- 向导语言：同键 lang 值持久化，维护/重装时恢复上次选择；默认简中。
         无专门语言页：两个欢迎页左下角原生语言下拉（JWORKLANG_SEL，值=显示名），
         选择变更挂 DoAction JpApplyLang + 条件 NewDialog（JWORKLANG_DIRTY="1"）：
         CA 用“下拉值与当前语言是否一致”辨认展开/确认语义——展开时一致不重建
         （选择不受打扰），确认选中新语言时置 DIRTY 并写属性，同批后行条件即时
         求值为真→重建孪生欢迎页（互跳避开 2856 自刷新），新页创建时整页已是
         新语言——下拉选完即变。欢迎页文案控件按语言三分拆分字面量变体，
         成对 show/hide 条件在页创建时求值选中其一。 -->
    <Property Id="JWORKLANG" Value="zh-CN"/>
    <Property Id="JWORKLANG_SEL"/>
    <Property Id="JWORKLANG_DIRTY" Value="0"/>
    <Property Id="JWORKLANG_EXISTING">
      <RegistrySearch Id="JworkLangSearch" Root="HKCU"
                      Key="Software\JavaSoft\Prefs\com\gettyio\jwork" Name="lang" Type="raw"/>
    </Property>
    <CustomAction Id="JpRestoreLang" Property="JWORKLANG" Value="[JWORKLANG_EXISTING]"/>
    <Binary Id="JpLangScript" SourceFile="lang.js"/>
    <CustomAction Id="JpApplyLang" BinaryKey="JpLangScript" JScriptCall="ApplyLang" Execute="immediate" Return="check"/>

    <DirectoryRef Id="TARGETDIR">
      <!-- 数据目录声明为真实 Directory：BrowseDlg 的 SetTargetPath 参数必须是目录 Id，
           纯自定义属性会报 2343（Specified folder is invalid）；目录属性已设值时
           引擎以其为路径，空目录无组件引用不会在磁盘创建 -->
      <Directory Id="JWORKDATADIR" Name="JworkData" />
      <!-- Permanent：卸载/升级后保留选择，重装时仍记住数据目录；卸载不触碰数据本身 -->
      <Component Id="JworkDataDirRegistry" Guid="{A3F8C6D2-9B4E-4F17-8A5C-2E9D7B6F4C10}" Permanent="yes">
        <RegistryValue Root="HKCU" Key="Software\JavaSoft\Prefs\com\gettyio\jwork"
                       Name="dataDir" Type="string" Value="[JWORKDATADIR]" KeyPath="yes"/>
      </Component>
      <!-- 语言选择同样 Permanent 留存；应用侧日后可经 Preferences 读取 lang -->
      <Component Id="JworkLangRegistry" Guid="{7E2B9D4A-5C1F-4E8B-9A3D-6F8C2B5E1D74}" Permanent="yes">
        <RegistryValue Root="HKCU" Key="Software\JavaSoft\Prefs\com\gettyio\jwork"
                       Name="lang" Type="string" Value="[JWORKLANG]" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
      <ComponentRef Id="JworkDataDirRegistry"/>
      <ComponentRef Id="JworkLangRegistry"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <!-- 三语自定义向导（单 msi，欢迎页原生语言下拉）：
         全部 22 个 WixUI 标准页同 Id 内联重定义，文案一律 [L_*] 属性引用，默认值简中；
         JpApplyLang JScript CA 在序列入口与下拉选择时覆写属性并替换内嵌 [ProductName]，
         下拉确认选语言后条件重建孪生欢迎页、新页整页新语言；许可证按语言显隐三份 RTF 之一。
         页面链：欢迎 → 许可证 → 安装位置 → 数据位置 → 快捷方式勾选 → 确认 → 进度 → 完成；
         维护模式（修复/卸载）与恢复安装分支由 InstallUISequence 条件 Show 进入。
         本文件由 build\gen\assemble.ps1 从 WixUIExtension 基线自动生成，勿手改。 -->
    <UI Id="JworkWizard">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />
      <!-- InstallDirDlg 绑定的目录属性指向 jpackage 的 INSTALLDIR（不传 win-dir-chooser 参数，由此处声明） -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

      <Property Id="L_Next" Value="下一步(&amp;N)" />
      <Property Id="L_Back" Value="上一步(&amp;B)" />
      <Property Id="L_Cancel" Value="取消" />
      <Property Id="L_Finish" Value="完成(&amp;F)" />
      <Property Id="L_OK" Value="确定" />
      <Property Id="L_Yes" Value="是(&amp;Y)" />
      <Property Id="L_No" Value="否(&amp;N)" />
      <Property Id="L_Retry" Value="重试(&amp;R)" />
      <Property Id="L_Ignore" Value="忽略(&amp;I)" />
      <Property Id="L_Print" Value="打印(&amp;P)" />
      <Property Id="L_DlgTitle" Value="[ProductName] 安装程序" />
      <Property Id="L_Welcome_Title" Value="{\WixUI_Font_Bigger}欢迎使用 [ProductName] 安装向导" />
      <Property Id="L_Welcome_Desc" Value="安装向导将在计算机上安装 [ProductName]。单击“下一步”继续，或单击“取消”退出安装向导。" />
      <Property Id="L_Welcome_DescUpdate" Value="安装向导将更新您计算机上的 [ProductName]。单击“下一步”继续或单击“取消”退出安装向导。" />
      <Property Id="L_License_Title" Value="{\WixUI_Font_Title}最终用户许可协议" />
      <Property Id="L_License_Desc" Value="请认真阅读以下许可协议" />
      <Property Id="L_License_Accept" Value="我接受许可协议中的条款(&amp;A)" />
      <Property Id="L_InstallDir_Title" Value="{\WixUI_Font_Title}目标文件夹" />
      <Property Id="L_InstallDir_Desc" Value="单击“下一步”安装到默认文件夹或单击“更改”选择其他位置。" />
      <Property Id="L_InstallDir_FolderLabel" Value="[ProductName] 安装位置:" />
      <Property Id="L_InstallDir_Change" Value="更改(&amp;C)..." />
      <Property Id="L_Data_Title" Value="{\WixUI_Font_Title}数据存储位置" />
      <Property Id="L_Data_Desc" Value="选择会话数据、配置与缓存的存放目录。" />
      <Property Id="L_Data_FolderLabel" Value="数据目录(&amp;D)：" />
      <Property Id="L_Data_Browse" Value="浏览(&amp;B)..." />
      <Property Id="L_Data_Hint" Value="数据独立于安装目录：卸载或升级不会删除数据。不建议将数据目录放在安装目录内部。更换数据目录后将以全新环境使用，原目录（默认 ~/.jwork）中的已有数据不会自动迁移。" />
      <Property Id="L_Shortcut_Title" Value="{\WixUI_Font_Title}快捷方式" />
      <Property Id="L_Shortcut_Desc" Value="选择要创建的快捷方式。" />
      <Property Id="L_Shortcut_Desktop" Value="创建桌面快捷方式" />
      <Property Id="L_Shortcut_StartMenu" Value="创建开始菜单快捷方式" />
      <Property Id="L_Verify_Install" Value="安装(&amp;I)" />
      <Property Id="L_Verify_Change" Value="更改(&amp;C)" />
      <Property Id="L_Verify_Repair" Value="修复(&amp;P)" />
      <Property Id="L_Verify_Remove" Value="删除(&amp;R)" />
      <Property Id="L_Verify_Update" Value="更新(&amp;U)" />
      <Property Id="L_Verify_InstallTitle" Value="{\WixUI_Font_Title}已准备好安装 [ProductName]" />
      <Property Id="L_Verify_InstallText" Value="单击“安装”开始安装。单击“上一步”查看或更改任何安装设置。单击“取消”退出向导。" />
      <Property Id="L_Verify_ChangeTitle" Value="{\WixUI_Font_Title}已准备好更改 [ProductName]" />
      <Property Id="L_Verify_ChangeText" Value="单击“更改”开始安装。单击“上一步”查看或更改任何安装设置。单击“取消”退出向导。" />
      <Property Id="L_Verify_RepairTitle" Value="{\WixUI_Font_Title}已准备好修复 [ProductName]" />
      <Property Id="L_Verify_RepairText" Value="单击“修复”修复 [ProductName] 的安装。单击“上一步”检查或更改任何安装设置。单击“取消”退出向导。" />
      <Property Id="L_Verify_RemoveTitle" Value="{\WixUI_Font_Title}已准备好删除 [ProductName]" />
      <Property Id="L_Verify_RemoveText" Value="单击“删除”可从计算机上删除 [ProductName]。单击“上一步”检查或更改任何安装设置。单击“取消”退出向导。" />
      <Property Id="L_Verify_UpdateTitle" Value="{\WixUI_Font_Title}已准备好更新 [ProductName]" />
      <Property Id="L_Verify_UpdateText" Value="单击“更新”以更新计算机上的 [ProductName]。单击“上一步”检查或更改任何安装设置。单击“取消”退出向导。" />
      <Property Id="L_Progress_TextInstalling" Value="安装向导正在安装 [ProductName]，请稍候。" />
      <Property Id="L_Progress_TitleInstalling" Value="{\WixUI_Font_Title}正在安装 [ProductName]" />
      <Property Id="L_Progress_TextChanging" Value="安装向导正在更改 [ProductName]，请稍候。" />
      <Property Id="L_Progress_TitleChanging" Value="{\WixUI_Font_Title}正在更改 [ProductName]" />
      <Property Id="L_Progress_TextRepairing" Value="安装向导正在修复 [ProductName]，请稍候。" />
      <Property Id="L_Progress_TitleRepairing" Value="{\WixUI_Font_Title}正在修复 [ProductName]" />
      <Property Id="L_Progress_TextRemoving" Value="安装向导正在删除 [ProductName]，请稍候。" />
      <Property Id="L_Progress_TitleRemoving" Value="{\WixUI_Font_Title}正在删除 [ProductName]" />
      <Property Id="L_Progress_TextUpdating" Value="安装向导正在更新 [ProductName]，请稍候。" />
      <Property Id="L_Progress_TitleUpdating" Value="{\WixUI_Font_Title}正在更新 [ProductName]" />
      <Property Id="L_Progress_Bar" Value="安装过程已完成" />
      <Property Id="L_Progress_Status" Value="状态:" />
      <Property Id="L_Exit_Title" Value="{\WixUI_Font_Bigger}[ProductName] 安装向导已完成" />
      <Property Id="L_Exit_Desc" Value="单击“完成”按钮退出安装向导。" />
      <Property Id="L_MaintWelcome_Desc" Value="通过安装向导可以更改在您的计算机上安装 [ProductName] 功能的方式，或将其从您的计算机中删除。单击“下一步”继续，或单击“取消”退出安装向导。" />
      <Property Id="L_MaintType_Title" Value="{\WixUI_Font_Title}更改、修复或删除安装" />
      <Property Id="L_MaintType_Desc" Value="选择希望执行的操作。" />
      <Property Id="L_MaintType_ChangeText" Value="允许您更改功能的安装方式。" />
      <Property Id="L_MaintType_ChangeDisabled" Value="[ProductName] 没有单独可选的功能。" />
      <Property Id="L_MaintType_RepairText" Value="通过修复丢失和损坏的文件、快捷方式和注册表项，修复最近安装的软件中的错误。" />
      <Property Id="L_MaintType_RepairDisabled" Value="[ProductName] 无法修复。" />
      <Property Id="L_MaintType_RemoveText" Value="从您的计算机中删除 [ProductName]。" />
      <Property Id="L_MaintType_RemoveDisabled" Value="[ProductName] 无法删除。" />
      <Property Id="L_MaintType_ChangeTip" Value="更改安装" />
      <Property Id="L_MaintType_RepairTip" Value="修复安装" />
      <Property Id="L_MaintType_RemoveTip" Value="删除安装" />
      <Property Id="L_Resume_Title" Value="{\WixUI_Font_Bigger}正在继续执行 [ProductName] 安装向导" />
      <Property Id="L_Resume_Desc" Value="安装向导将在您的计算机上完成 [ProductName] 的安装。请单击“安装”继续，或单击“取消”退出安装向导。" />
      <Property Id="L_Cancel_Text" Value="是否确实要取消安装 [ProductName]?" />
      <Property Id="L_Info_IconTip" Value="信息图标" />
      <Property Id="L_Error_Text" Value="信息文本" />
      <Property Id="L_Fatal_Title" Value="{\WixUI_Font_Bigger}[ProductName] 安装向导提前结束" />
      <Property Id="L_Fatal_Desc" Value="由于发生错误，[ProductName] 安装向导提前结束。您的系统尚未修改。若要稍后安装该程序，请再次运行安装向导。 单击“完成”按钮退出安装向导。" />
      <Property Id="L_UserExit_Title" Value="{\WixUI_Font_Bigger}[ProductName] 安装向导中断" />
      <Property Id="L_UserExit_Desc" Value="[ProductName] 安装程序已中断。您的系统尚未修改。若要稍后安装此程序，请再次运行安装程序。 单击“完成”按钮退出安装向导。" />
      <Property Id="L_Browse_Title" Value="{\WixUI_Font_Title}更改目标文件夹" />
      <Property Id="L_Browse_Desc" Value="浏览到目标文件夹" />
      <Property Id="L_Browse_ComboLabel" Value="查找范围(&amp;L):" />
      <Property Id="L_Browse_PathLabel" Value="文件夹名称(&amp;F):" />
      <Property Id="L_Browse_UpTip" Value="向上一级" />
      <Property Id="L_Browse_NewTip" Value="新建文件夹" />
      <Property Id="L_InvalidDir_Text" Value="安装目录必须位于本地硬盘驱动器上。" />
      <Property Id="L_DiskCost_Title" Value="{\WixUI_Font_Title}磁盘空间要求" />
      <Property Id="L_DiskCost_Desc" Value="安装选择的功能所需的磁盘空间。" />
      <Property Id="L_DiskCost_Text" Value="突出显示的卷没有足够的磁盘空间用于所选功能。您可以从突出显示的卷中删除一些文件，安装较少的功能，或者选择其他目标驱动器。" />
      <Property Id="L_OutOfDisk_Title" Value="{\WixUI_Font_Title}磁盘空间不足" />
      <Property Id="L_OutOfDisk_Desc" Value="安装所需的磁盘空间超出了可用磁盘空间。" />
      <Property Id="L_OutOfDisk_Text" Value="突出显示的卷没有足够的磁盘空间用于安装当前所选功能。您可以从突出显示的卷中删除一些文件，安装较少的功能，或者选择其他目标驱动器。" />
      <Property Id="L_OutOfRb_Text" Value="突出显示的卷没有足够的磁盘空间用于安装当前所选功能。您可以从突出显示的卷中删除一些文件，安装较少的功能，或者选择其他目标驱动器。 或者，您可以选择禁用安装程序的回滚功能。禁用回滚功能将在因任何原因中断安装时，阻止安装程序还原计算机的原始状态。如果希望冒险禁用回滚功能，请单击“是”。" />
      <Property Id="L_FilesInUse_Title" Value="{\WixUI_Font_Title}使用中的文件" />
      <Property Id="L_FilesInUse_Desc" Value="一些需要更新的文件当前正在使用中。" />
      <Property Id="L_FilesInUse_Text" Value="以下应用程序正在使用需要通过此安装程序更新的文件。请关闭这些应用程序，然后单击“重试”继续安装，或单击“退出”退出安装(&amp;R)。" />
      <Property Id="L_FilesInUse_Exit" Value="退出(&amp;X)" />
      <Property Id="L_RM_Text" Value="以下应用程序正在使用此安装程序需要更新的文件。可以让安装向导关闭这些应用程序，稍后再尝试重新启动这些应用程序或重新启动计算机。" />
      <Property Id="L_RM_UseRM" Value="关闭应用程序，然后尝试将其重新启动(&amp;C)。" />
      <Property Id="L_RM_DontUseRM" Value="不关闭应用程序。需要重新启动(&amp;D)。" />
      <Property Id="L_Wait_Text" Value="安装程序正在确定磁盘空间需求，请稍候。" />
      <Property Id="L_Wait_Return" Value="返回(&amp;R)" />
      <Property Id="L_Wait_IconTip" Value="感叹号图标" />
      <Property Id="L_Prepare_Desc" Value="安装程序正在准备 [ProductName]，请稍候。" />

      <!-- 数据位置页：文案走 L_Data_* 属性；语言切换仅在欢迎页，本页只读 L_* -->
      <Dialog Id="JworkDataDlg" Width="370" Height="270" Title="[L_DlgTitle]" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="[L_Data_Title]" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="[L_Data_Desc]" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="70" Width="330" Height="15" NoPrefix="yes"
                 Text="[L_Data_FolderLabel]" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="85" Width="260" Height="18"
                 Property="JWORKDATADIR" />
        <Control Id="Change" Type="PushButton" X="290" Y="84" Width="60" Height="18"
                 Text="[L_Data_Browse]">
          <!-- _BrowseProperty 须为目录 Id 字面量（同 InstallDirDlg 经 WIXUI_INSTALLDIR 间接到
               INSTALLDIR 的机制）：BrowseDlg OK 的 SetTargetPath 参数是目录 Id，填路径字符串
               会报 2343；JWORKDATADIR 已在 part1 声明为真实 Directory -->
          <Publish Property="_BrowseProperty" Value="JWORKDATADIR" Order="1">1</Publish>
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
        </Control>
        <Control Id="Hint" Type="Text" X="20" Y="115" Width="330" Height="90" NoPrefix="yes"
                 Text="[L_Data_Hint]" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="[L_Back]" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="[L_Next]" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="[L_Cancel]">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="[L_DlgTitle]">
        <Control Id="PathEdit" Type="PathEdit" X="25" Y="202" Width="320" Height="18" Indirect="yes" Property="_BrowseProperty" TabSkip="no" />
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" TabSkip="no" Default="yes" Text="[L_OK]">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1">1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" TabSkip="no" Cancel="yes" Text="[L_Cancel]">
          <Publish Event="Reset" Value="0" Order="1">1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="2">1</Publish>
        </Control>
        <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" TabSkip="no" Text="[L_Browse_ComboLabel]" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="220" Height="80" Indirect="yes" Fixed="yes" Remote="yes" Property="_BrowseProperty" TabSkip="no">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="WixUI_Bmp_Up" Type="PushButton" X="298" Y="55" Width="19" Height="19" Icon="yes" FixedSize="yes" IconSize="16" TabSkip="no" Help="[L_Browse_UpTip]" Text="WixUI_Bmp_Up">
          <Publish Event="DirectoryListUp" Value="0" Order="1">1</Publish>
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="325" Y="55" Width="19" Height="19" Icon="yes" FixedSize="yes" IconSize="16" TabSkip="no" Help="[L_Browse_NewTip]" Text="WixUI_Bmp_New">
          <Publish Event="DirectoryListNew" Value="0" Order="1">1</Publish>
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="98" Sunken="yes" Indirect="yes" Property="_BrowseProperty" TabSkip="no" />
        <Control Id="PathLabel" Type="Text" X="25" Y="190" Width="320" Height="10" TabSkip="no" Text="[L_Browse_PathLabel]" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Disabled="yes" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_Browse_Desc]" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" TabSkip="yes" Text="[L_Browse_Title]" />
      </Dialog>

      <Dialog Id="CancelDlg" Width="260" Height="85" Title="[L_DlgTitle]">
        <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17" TabSkip="no" Default="yes" Cancel="yes" Text="[L_No]">
          <Publish Event="EndDialog" Value="Return" Order="1">1</Publish>
        </Control>
        <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" TabSkip="no" Text="[L_Yes]">
          <Publish Event="EndDialog" Value="Exit" Order="1">1</Publish>
        </Control>
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" NoPrefix="yes" TabSkip="yes" Text="[L_Cancel_Text]" />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" Disabled="yes" FixedSize="yes" IconSize="32" TabSkip="yes" Help="[L_Info_IconTip]" Text="WixUI_Ico_Info" />
      </Dialog>

      <Dialog Id="DiskCostDlg" Width="370" Height="270" Title="[L_DlgTitle]">
